{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>udondan/renovate-config"],
  "minimumReleaseAge": null,
  "automerge": false,
  "rebaseWhen": "auto",
  "prConcurrentLimit": 0,
  "ignorePaths": ["**/node_modules/**"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
